# Copy to .env and fill in values from your Supabase dev project.
# NEXT_PUBLIC_* values are exposed to the browser; never put secrets in them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# AI assistant (server-only). Uses a local Ollama server by default.
# AI_PROVIDER is "ollama" (local, the default), "openai" (hosted) or "disabled".
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window in tokens. Ollama defaults to 4096, too small for the report; 8192 fits qwen2.5:7b on 8 GB.
OLLAMA_NUM_CTX=8192
# Hosted AI with OpenAI: set AI_PROVIDER=openai and fill in the next two lines.
# OPENAI_API_KEY is a server-only secret: never prefix it with NEXT_PUBLIC_, and
# use a project key with a spending limit set in the OpenAI dashboard.
# OPENAI_MODEL has no default on purpose. Pick a current chat model that supports
# structured outputs from https://platform.openai.com/docs/models, then run
# `pnpm ai:eval` with it before launch (that run spends tokens on your account).
# If either is missing, AI answers and reports are unavailable (the app still runs).
# OPENAI_BASE_URL is optional (default https://api.openai.com). It must be https,
# or http on localhost, for example for a local test server. A trailing /v1 or /
# is fine; do not add a query string.
# OPENAI_REASONING_EFFORT is optional and only used for reasoning models (the
# o-series and gpt-5 family). One of none, minimal, low, medium, high; the default
# is low. Not every model accepts every value (for example none needs gpt-5.1 or
# later); a model that rejects the setting gets the field dropped automatically.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_REASONING_EFFORT=low
AI_DAILY_QUESTION_LIMIT=30
AI_DAILY_REPORT_LIMIT=3

# Analytics (server-only). Random string of at least 16 characters, for example
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# It keys the pseudonymous user reference; keep it secret and do not change it
# once set. Analytics is off while this is empty.
ANALYTICS_SALT=

# Closed beta. Set to "on" to ask for an invite code at sign-up. The code is
# checked by the "Before user created" auth hook (see
# supabase/migrations/20261001110000_beta_gate.sql); turn that hook on too.
# The gate also needs SUPABASE_SECRET_KEY and the beta_gate migration applied.
BETA_GATE=

# Google sign-in. Shows the "Continue with Google" button on /login and /signup.
# Needs the Google provider enabled in the Supabase dashboard (client id and
# secret from Google Cloud) and <site URL>/auth/callback in the Supabase
# redirect allow list. Set to "off" to hide the button.
# Keep "Confirm email" turned on in Supabase Authentication settings: that is
# what removes an unconfirmed password sign-up when the real owner signs in
# with Google.
# Turning this off later leaves people who only use Google unable to sign in
# or to delete their account.
GOOGLE_AUTH=on

# Error monitoring (Sentry). Nothing is sent while the DSNs are empty. Sentry
# gets only the error type, stack frames, release and route; never message text,
# requests, users or breadcrumbs.
# SENTRY_DSN covers the server; NEXT_PUBLIC_SENTRY_DSN (exposed to the browser)
# covers the browser. NEXT_PUBLIC_RELEASE labels the build; it falls back to
# VERCEL_GIT_COMMIT_SHA, then the package version.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RELEASE=

# Contact address shown on the Privacy Policy and Terms (exposed to the browser).
# Public, set at build time. Leave it empty and the pages say a contact address
# will be listed, so setting it is a launch blocker.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Set to exactly "true" once a lawyer has reviewed the Terms, Privacy Policy and
# Disclaimer. Until then /legal/* shows "Draft version ..., pending legal review."
# Public, set at build time.
NEXT_PUBLIC_LEGAL_REVIEWED=
